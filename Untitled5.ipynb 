        "import os\n",
        "import urllib.request\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.model_selection import (\n",
        "    train_test_split,\n",
        "    StratifiedKFold,\n",
        "    cross_validate,\n",
        "    GridSearchCV\n",
        ")\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.base import BaseEstimator, TransformerMixin\n",
        "from pandas.plotting import scatter_matrix\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    f1_score,\n",
        "    classification_report,\n",
        "    ConfusionMatrixDisplay\n",
        ")\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "DATA_PATH = \"winequality-white.csv\"\n",
        "DATA_URL = \"https://archive.ics.uci.edu/ml/machine-learning-databases/wine-quality/winequality-white.csv\"\n",
        "\n",
        "if not os.path.exists(DATA_PATH):\n",
        "    print(\"Nie znaleziono pliku lokalnego, pobieram dane...\")\n",
        "    urllib.request.urlretrieve(DATA_URL, DATA_PATH)\n",
        "\n",
        "wine = pd.read_csv(DATA_PATH, sep=\";\")\n",
        "\n",
        "print(\"Pierwsze 5 wierszy:\")\n",
        "display(wine.head())\n",
        "\n",
        "print(\"Liczba wierszy i kolumn:\")\n",
        "print(wine.shape)\n",
        "\n",
        "print(\"\\nInformacje o danych:\")\n",
        "wine.info()\n",
        "\n",
        "print(\"\\nStatystyki opisowe:\")\n",
        "display(wine.describe().T)\n",
        "\n",
        "print(\"\\nBraki danych:\")\n",
        "display(wine.isna().sum())\n",
        "\n",
        "print(\"\\nLiczba zduplikowanych wierszy:\")\n",
        "print(wine.duplicated().sum())\n",
        "\n",
        "print(\"\\nRozkład quality:\")\n",
        "display(wine[\"quality\"].value_counts().sort_index())\n",
        "\n",
        "quality_counts = wine[\"quality\"].value_counts().sort_index()\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "quality_counts.plot(kind=\"bar\")\n",
        "plt.title(\"Rozkład ocen jakości wina\")\n",
        "plt.xlabel(\"Quality\")\n",
        "plt.ylabel(\"Liczba próbek\")\n",
        "plt.show()\n",
        "\n",
        "wine.hist(figsize=(14, 10), bins=30)\n",
        "plt.suptitle(\"Histogramy cech\", y=1.02)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.scatter(wine[\"alcohol\"], wine[\"quality\"], alpha=0.25)\n",
        "plt.title(\"Zależność: alcohol vs quality\")\n",
        "plt.xlabel(\"Alcohol\")\n",
        "plt.ylabel(\"Quality\")\n",
        "plt.show()\n",
        "\n",
        "wine_clean = wine.drop_duplicates().reset_index(drop=True)\n",
        "\n",
        "print(\"Rozmiar przed czyszczeniem:\", wine.shape)\n",
        "print(\"Rozmiar po usunięciu duplikatów:\", wine_clean.shape)\n",
        "print(\"Usunięto wierszy:\", len(wine) - len(wine_clean))\n",
        "\n",
        "X = wine_clean.drop(columns=[\"quality\"])\n",
        "y = wine_clean[\"quality\"]\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.2,\n",
        "    random_state=RANDOM_STATE,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "print(\"X_train:\", X_train.shape)\n",
        "print(\"X_test:\", X_test.shape)\n",
        "\n",
        "print(\"\\nRozkład klas w treningu:\")\n",
        "display(y_train.value_counts(normalize=True).sort_index())\n",
        "\n",
        "print(\"\\nRozkład klas w teście:\")\n",
        "display(y_test.value_counts(normalize=True).sort_index())\n",
        "\n",
        "train_eda = X_train.copy()\n",
        "train_eda[\"quality\"] = y_train.to_numpy()\n",
        "\n",
        "corr_matrix = train_eda.corr(numeric_only=True)\n",
        "quality_corr = corr_matrix[\"quality\"].sort_values(ascending=False)\n",
        "\n",
        "print(\"Korelacje cech z quality:\")\n",
        "display(quality_corr)\n",
        "\n",
        "top_features = (\n",
        "    quality_corr\n",
        "    .drop(\"quality\")\n",
        "    .abs()\n",
        "    .sort_values(ascending=False)\n",
        "    .head(4)\n",
        "    .index\n",
        "    .tolist()\n",
        ")\n",
        "\n",
        "scatter_attributes = [\"quality\"] + top_features\n",
        "print(\"Cechy użyte w scatter_matrix:\", scatter_attributes)\n",
        "\n",
        "scatter_matrix(\n",
        "    train_eda[scatter_attributes],\n",
        "    figsize=(12, 10),\n",
        "    diagonal=\"hist\",\n",
        "    alpha=0.25\n",
        ")\n",
        "plt.suptitle(\"Scatter matrix najważniejszych cech\", y=1.02)\n",
        "plt.show()\n",
        "\n",
        "feature_names = list(X_train.columns)\n",
        "\n",
        "free_so2_ix = feature_names.index(\"free sulfur dioxide\")\n",
        "total_so2_ix = feature_names.index(\"total sulfur dioxide\")\n",
        "residual_sugar_ix = feature_names.index(\"residual sugar\")\n",
        "alcohol_ix = feature_names.index(\"alcohol\")\n",
        "volatile_acidity_ix = feature_names.index(\"volatile acidity\")\n",
        "fixed_acidity_ix = feature_names.index(\"fixed acidity\")\n",
        "\n",
        "class WineAttributesAdder(BaseEstimator, TransformerMixin):\n",
        "    def fit(self, X, y=None):\n",
        "        return self\n",
        "\n",
        "    def transform(self, X):\n",
        "        eps = 1e-9\n",
        "        free_sulfur_ratio = X[:, free_so2_ix] / (X[:, total_so2_ix] + eps)\n",
        "        sugar_alcohol_ratio = X[:, residual_sugar_ix] / (X[:, alcohol_ix] + eps)\n",
        "        volatile_fixed_acidity_ratio = X[:, volatile_acidity_ix] / (X[:, fixed_acidity_ix] + eps)\n",
        "\n",
        "        return np.c_[\n",
        "            X,\n",
        "            free_sulfur_ratio,\n",
        "            sugar_alcohol_ratio,\n",
        "            volatile_fixed_acidity_ratio\n",
        "        ]\n",
        "\n",
        "new_feature_names = [\n",
        "    \"free_sulfur_ratio\",\n",
        "    \"sugar_alcohol_ratio\",\n",
        "    \"volatile_fixed_acidity_ratio\"\n",
        "]\n",
        "\n",
        "print(\"Nowe cechy:\", new_feature_names)\n",
        "\n",
        "imputer_for_eda = SimpleImputer(strategy=\"median\")\n",
        "X_train_imputed = imputer_for_eda.fit_transform(X_train)\n",
        "\n",
        "adder_for_eda = WineAttributesAdder()\n",
        "X_train_extended = adder_for_eda.fit_transform(X_train_imputed)\n",
        "\n",
        "extended_columns = list(X_train.columns) + new_feature_names\n",
        "\n",
        "train_extended_df = pd.DataFrame(\n",
        "    X_train_extended,\n",
        "    columns=extended_columns,\n",
        "    index=X_train.index\n",
        ")\n",
        "train_extended_df[\"quality\"] = y_train\n",
        "\n",
        "extended_corr = (\n",
        "    train_extended_df\n",
        "    .corr(numeric_only=True)[\"quality\"]\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "display(extended_corr)\n",
        "\n",
        "min_class_count = int(y_train.value_counts().min())\n",
        "\n",
        "if min_class_count < 2:\n",
        "    raise ValueError(\"Najrzadsza klasa ma mniej niż 2 próbki w zbiorze treningowym.\")\n",
        "\n",
        "n_splits = min(5, min_class_count)\n",
        "\n",
        "cv = StratifiedKFold(\n",
        "    n_splits=n_splits,\n",
        "    shuffle=True,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "print(\"Liczba foldów walidacji:\", n_splits)\n",
        "\n",
        "logistic_model = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "    (\"attribs_adder\", WineAttributesAdder()),\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"model\", LogisticRegression(\n",
        "        max_iter=3000,\n",
        "        class_weight=\"balanced\",\n",
        "        random_state=RANDOM_STATE\n",
        "    ))\n",
        "])\n",
        "\n",
        "scoring = {\n",
        "    \"accuracy\": \"accuracy\",\n",
        "    \"f1_macro\": \"f1_macro\"\n",
        "}\n",
        "\n",
        "logistic_cv = cross_validate(\n",
        "    logistic_model,\n",
        "    X_train,\n",
        "    y_train,\n",
        "    cv=cv,\n",
        "    scoring=scoring,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "logistic_accuracy = logistic_cv[\"test_accuracy\"].mean()\n",
        "logistic_f1 = logistic_cv[\"test_f1_macro\"].mean()\n",
        "\n",
        "print(\"Logistic Regression - średnie Accuracy:\", logistic_accuracy)\n",
        "print(\"Logistic Regression - średnie F1 macro:\", logistic_f1)\n",
        "\n",
        "tree_model = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "    (\"attribs_adder\", WineAttributesAdder()),\n",
        "    (\"model\", DecisionTreeClassifier(random_state=RANDOM_STATE))\n",
        "])\n",
        "\n",
        "tree_model.fit(X_train, y_train)\n",
        "\n",
        "tree_train_pred = tree_model.predict(X_train)\n",
        "tree_train_accuracy = accuracy_score(y_train, tree_train_pred)\n",
        "tree_train_f1 = f1_score(y_train, tree_train_pred, average=\"macro\")\n",
        "\n",
        "print(\"Decision Tree - Accuracy na treningu:\", tree_train_accuracy)\n",
        "print(\"Decision Tree - F1 macro na treningu:\", tree_train_f1)\n",
        "\n",
        "tree_cv = cross_validate(\n",
        "    tree_model,\n",
        "    X_train,\n",
        "    y_train,\n",
        "    cv=cv,\n",
        "    scoring=scoring,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "tree_accuracy = tree_cv[\"test_accuracy\"].mean()\n",
        "tree_f1 = tree_cv[\"test_f1_macro\"].mean()\n",
        "\n",
        "print(\"Decision Tree - średnie Accuracy w CV:\", tree_accuracy)\n",
        "print(\"Decision Tree - średnie F1 macro w CV:\", tree_f1)\n",
        "print(\"Różnica F1 trening - CV:\", tree_train_f1 - tree_f1)\n",
        "\n",
        "forest_pipeline = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "    (\"attribs_adder\", WineAttributesAdder()),\n",
        "    (\"model\", RandomForestClassifier(\n",
        "        random_state=RANDOM_STATE,\n",
        "        n_jobs=-1\n",
        "    ))\n",
        "])\n",
        "\n",
        "param_grid = {\n",
        "    \"model__n_estimators\": [100, 300],\n",
        "    \"model__max_depth\": [None, 10, 20],\n",
        "    \"model__min_samples_split\": [2, 5],\n",
        "    \"model__min_samples_leaf\": [1, 2],\n",
        "    \"model__max_features\": [\"sqrt\", \"log2\"],\n",
        "    \"model__class_weight\": [None, \"balanced\"]\n",
        "}\n",
        "\n",
        "grid_search = GridSearchCV(\n",
        "    estimator=forest_pipeline,\n",
        "    param_grid=param_grid,\n",
        "    scoring=\"f1_macro\",\n",
        "    cv=cv,\n",
        "    n_jobs=-1,\n",
        "    refit=True\n",
        ")\n",
        "\n",
        "grid_search.fit(X_train, y_train)\n",
        "\n",
        "print(\"Najlepsze hiperparametry Random Forest:\")\n",
        "print(grid_search.best_params_)\n",
        "print(\"Najlepsze średnie F1 macro:\", grid_search.best_score_)\n",
        "\n",
        "best_forest = grid_search.best_estimator_\n",
        "\n",
        "forest_cv = cross_validate(\n",
        "    best_forest,\n",
        "    X_train,\n",
        "    y_train,\n",
        "    cv=cv,\n",
        "    scoring=scoring,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "forest_accuracy = forest_cv[\"test_accuracy\"].mean()\n",
        "forest_f1 = forest_cv[\"test_f1_macro\"].mean()\n",
        "\n",
        "print(\"Random Forest - średnie Accuracy:\", forest_accuracy)\n",
        "print(\"Random Forest - średnie F1 macro:\", forest_f1)\n",
        "\n",
        "cv_results = pd.DataFrame([\n",
        "    {\n",
        "        \"model\": \"Logistic Regression\",\n",
        "        \"CV Accuracy\": logistic_accuracy,\n",
        "        \"CV F1 macro\": logistic_f1\n",
        "    },\n",
        "    {\n",
        "        \"model\": \"Decision Tree Classifier\",\n",
        "        \"CV Accuracy\": tree_accuracy,\n",
        "        \"CV F1 macro\": tree_f1\n",
        "    },\n",
        "    {\n",
        "        \"model\": \"Random Forest Classifier\",\n",
        "        \"CV Accuracy\": forest_accuracy,\n",
        "        \"CV F1 macro\": forest_f1\n",
        "    }\n",
        "]).sort_values(\"CV F1 macro\", ascending=False)\n",
        "\n",
        "display(cv_results)\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.bar(cv_results[\"model\"], cv_results[\"CV F1 macro\"])\n",
        "plt.title(\"Porównanie modeli według F1 macro\")\n",
        "plt.ylabel(\"F1 macro\")\n",
        "plt.xticks(rotation=15)\n",
        "plt.show()\n",
        "\n",
        "model_candidates = {\n",
        "    \"Logistic Regression\": (logistic_model, logistic_f1),\n",
        "    \"Decision Tree Classifier\": (tree_model, tree_f1),\n",
        "    \"Random Forest Classifier\": (best_forest, forest_f1)\n",
        "}\n",
        "\n",
        "final_model_name = max(\n",
        "    model_candidates,\n",
        "    key=lambda name: model_candidates[name][1]\n",
        ")\n",
        "\n",
        "final_model = model_candidates[final_model_name][0]\n",
        "\n",
        "print(\"Wybrany model:\", final_model_name)\n",
        "print(\"Najlepsze CV F1 macro:\", model_candidates[final_model_name][1])\n",
        "\n",
        "final_model.fit(X_train, y_train)\n",
        "y_pred = final_model.predict(X_test)\n",
        "\n",
        "test_accuracy = accuracy_score(y_test, y_pred)\n",
        "test_f1_macro = f1_score(y_test, y_pred, average=\"macro\")\n",
        "\n",
        "print(\"FINALNY WYNIK NA ZBIORZE TESTOWYM\")\n",
        "print(\"Model:\", final_model_name)\n",
        "print(\"Accuracy:\", test_accuracy)\n",
        "print(\"F1 macro:\", test_f1_macro)\n",
        "\n",
        "print(\"\\nClassification report:\")\n",
        "print(classification_report(y_test, y_pred, zero_division=0))\n",
        "\n",
        "ConfusionMatrixDisplay.from_predictions(\n",
        "    y_test,\n",
        "    y_pred,\n",
        "    labels=sorted(y.unique()),\n",
        "    cmap=\"Blues\"\n",
        ")\n",
        "plt.title(\"Macierz pomyłek - \" + final_model_name)\n",
        "plt.show()\n",
        "\n",
        "best_forest.fit(X_train, y_train)\n",
        "\n",
        "rf_classifier = best_forest.named_steps[\"model\"]\n",
        "rf_feature_names = list(X_train.columns) + new_feature_names\n",
        "\n",
        "importances = pd.Series(\n",
        "    rf_classifier.feature_importances_,\n",
        "    index=rf_feature_names\n",
        ").sort_values(ascending=True)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "importances.plot(kind=\"barh\")\n",
        "plt.title(\"Ważność cech - Random Forest\")\n",
        "plt.xlabel(\"Importance\")\n",
        "plt.show()\n",
        "\n",
        "display(importances.sort_values(ascending=False))\n",
        "\n",
        "print(\"WNIOSKI KONCOWE\")\n",
        "print(\"Wybrany model:\", final_model_name)\n",
        "print(\"Test Accuracy:\", test_accuracy)\n",
        "print(\"Test F1 macro:\", test_f1_macro)\n",
        "\n",
        "cv_results.to_csv(\"wyniki_cv.csv\", index=False)\n",
        "\n",
        "test_results = pd.DataFrame([{\n",
        "    \"model\": final_model_name,\n",
        "    \"Test Accuracy\": test_accuracy,\n",
        "    \"Test F1 macro\": test_f1_macro\n",
        "}])\n",
        "test_results.to_csv(\"wynik_testowy.csv\", index=False)\n"
      ]
